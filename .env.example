# =============================================================================
# SMART ATTENDANCE SYSTEM - ENVIRONMENT CONFIGURATION (100% FREE HOSTING)
# =============================================================================
# DO NOT commit real secrets or passwords to Git.
# Copy this file to .env for local testing or enter these values in Render dashboard.

# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000

# Environment Mode: development | production
NODE_ENV=production

# Public URL of your deployed application (Optional)
# If omitted, the server automatically infers this from the incoming request (e.g., https://your-service.onrender.com)
PUBLIC_URL=https://smart-attendance-system.onrender.com

# -----------------------------------------------------------------------------
# FREE PERSISTENT DATABASE: MongoDB Atlas (M0 Free Tier - 512MB, No Credit Card)
# -----------------------------------------------------------------------------
# 1. Sign up at https://www.mongodb.com/cloud/atlas (Free)
# 2. Deploy a free M0 cluster
# 3. Create a database user & password
# 4. Under Network Access, allow IP 0.0.0.0/0 (all IPs)
# 5. Click "Connect" -> "Drivers" (Node.js) -> copy the connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_attendance?retryWrites=true&w=majority

# Database name and collection name (defaults are used if omitted)
MONGODB_DB_NAME=smart_attendance
MONGODB_COLLECTION=system_store
